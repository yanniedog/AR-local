[Unit]
Description=AR-local daily ingest observation only
After=network-online.target
Wants=network-online.target
OnFailure=ar-local-ingest-alert.service

[Service]
Type=oneshot
CPUQuota=300%
CPUWeight=500
IOWeight=500
KillMode=control-group
TimeoutStopSec=45s
TimeoutStartSec=6h15min
User={{AR_LOCAL_USER}}
Group={{AR_LOCAL_GROUP}}
WorkingDirectory={{AR_LOCAL_REPO}}
Environment=AR_LOCAL_PORTABLE_ROOT={{AR_LOCAL_PORTABLE_ROOT}}
Environment=AR_LOCAL_DATA_ROOT={{AR_LOCAL_DATA_ROOT}}
Environment=HOME={{AR_LOCAL_HOME}}
Environment=XDG_CONFIG_HOME={{AR_LOCAL_HOME}}/.config
# Optional mobile-app payload publishing (inherited by the pi_daily_sync subprocess).
EnvironmentFile=-/etc/ar-local/app-payload.env
EnvironmentFile=-/etc/ar-local/drive-backup.env
ExecStart=/usr/bin/python3 -B {{AR_LOCAL_REPO}}/pi_ingest_observe.py
# Observation never launches repairs or pauses serving; no restore hook is needed.
