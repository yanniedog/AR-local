# Install as /etc/ar-local/day-archive.env (no secrets).
AR_LOCAL_DATA_ROOT=/srv/ar-local/data
AR_LOCAL_DAY_ARCHIVE_SPOOL=/var/lib/ar-local-day-archives
# Match the enrolled dedicated Drive backup remote (see /etc/ar-local/drive-backup.env).
AR_LOCAL_DAY_ARCHIVE_REMOTE="ar_local_drive_dedicated_20260913:AR-local Pi Backups Dedicated 20260913-326040d72fbc405ea2e9b2dacea6b412/daily-cdr-day-archives"
RCLONE_CONFIG=/var/lib/ar-local-drive-backup/credentials/dedicated-20260913-ready3/rclone-verified-ready3.conf
# Optional pin; leave empty to use the enrolled drive.file remote paths:
# AR_LOCAL_DRIVE_ROOT_FOLDER_ID=
