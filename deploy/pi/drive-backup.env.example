# Install as /etc/ar-local/drive-backup.env; no token or password here.
AR_LOCAL_DATA_ROOT=/srv/ar-local/data
AR_LOCAL_DRIVE_BACKUP_SPOOL=/var/lib/ar-local-drive-backup
RESTIC_REPOSITORY="rclone:ar_local_drive:AR-local Pi Backups/restic"
RESTIC_PASSWORD_FILE=/var/lib/ar-local-drive-backup/credentials/restic.password
RCLONE_CONFIG=/var/lib/ar-local-drive-backup/credentials/rclone.conf
