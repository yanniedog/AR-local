[Unit]
Description=Restore expired or orphaned AR-local Drive reclaim lease

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/ar-local-drive-reclaim/pi_drive_reclaim.py reconcile
TimeoutStartSec=90s
UMask=0077
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
