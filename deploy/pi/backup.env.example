# Install as /etc/ar-local/backup.env (root:<service-group> 0640).
# Use stable /dev/disk/by-uuid/... identity, never /dev/sdX.
AR_BACKUP_MOUNTPOINT=/mnt/ar-local-backup
AR_BACKUP_EXPECTED_SOURCE=/dev/disk/by-uuid/REPLACE_WITH_VERIFIED_UUID
AR_BACKUP_EXPECTED_FSTYPE=ext4
AR_BACKUP_DIRECTORY=/mnt/ar-local-backup/ar-local
AR_BACKUP_EXPECTED_UID=1000
AR_BACKUP_EXPECTED_GID=1000
AR_BACKUP_MAX_AGE_HOURS=36
AR_BACKUP_RESTORE_MAX_AGE_HOURS=192
AR_BACKUP_BOOT_PROOF_MAX_AGE_HOURS=2160
AR_BACKUP_MIN_FREE_BYTES=10737418240
AR_BACKUP_PLAN_GIT_COMMIT=4a3af1ccbdc24deefe3d12da2f7152946984f459
AR_BACKUP_PLAN_SHA256=510937fc4d09d0e9066c5830fedd80053c9d3c40a062c34c8acce764f1fa8adc
AR_BACKUP_PLAN_RAW_SHA256=0e40cba6682f0bd95bc48e2df044e387ebfeaa1a2a3e590145507a03cbf94d7c
