[Unit]
Description=AR-local non-destructive storage runway monitor
After=local-fs.target

[Service]
Type=oneshot
User={{AR_LOCAL_USER}}
Group={{AR_LOCAL_GROUP}}
WorkingDirectory={{AR_LOCAL_REPO}}
Environment=PYTHONUNBUFFERED=1
Environment=AR_LOCAL_DATA_ROOT={{AR_LOCAL_DATA_ROOT}}
EnvironmentFile=-/etc/ar-local/notify.env
ExecStart=/usr/bin/python3 {{AR_LOCAL_REPO}}/pi_capacity_monitor.py --data-root {{AR_LOCAL_DATA_ROOT}} --notify

