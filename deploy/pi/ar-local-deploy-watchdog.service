[Unit]
Description=AR-local Pi deploy verify (sync + /api/latest smoke)
After=network-online.target ar-local-dashboard.service
Wants=network-online.target

[Service]
# Run verification as the repo owner so refreshing remote refs and reading the
# checkout do not trigger Git's dubious-ownership protection. This unit never
# pulls, switches, restarts services, or deploys code.
User={{AR_LOCAL_USER}}
Group={{AR_LOCAL_GROUP}}
Type=oneshot
WorkingDirectory={{AR_LOCAL_REPO}}
Environment=AR_PI_VERIFY_LOCAL=1
Environment=AR_PI_BASE_URL=http://127.0.0.1/
ExecStart={{AR_LOCAL_REPO}}/deploy/pi/ar-local-deploy-watchdog.sh

[Install]
WantedBy=multi-user.target
