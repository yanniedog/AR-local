[Unit]
Description=Daily AR-local Google Drive backup at 03:30 Hobart

[Timer]
OnCalendar=*-*-* 03:30:00 Australia/Hobart
# The eligible half-hour queue timer handles a missed daily run after boot.
Persistent=false
AccuracySec=1min
Unit=ar-local-drive-backup.service

[Install]
WantedBy=timers.target
