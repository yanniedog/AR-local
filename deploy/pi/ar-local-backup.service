[Unit]
Description=AR-local off-device preservation snapshot
Documentation=file://{{AR_LOCAL_REPO}}/docs/PI_INGEST_PAYLOAD_RECOVERY_RUNBOOK.md
After=local-fs.target ar-local-daily.service ar-local-ingest-now.service
RequiresMountsFor=/mnt/ar-local-backup
ConditionPathExists=/etc/ar-local/backup.env

[Service]
Type=oneshot
User={{AR_LOCAL_USER}}
Group={{AR_LOCAL_GROUP}}
WorkingDirectory={{AR_LOCAL_REPO}}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/ar-local-backup-run snapshot {{AR_LOCAL_REPO}} {{AR_SITE_ROOT}}/.. {{AR_LOCAL_DATA_ROOT}}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
