[Unit]
Description=AR-local off-device preservation snapshot
Documentation=file://{{AR_LOCAL_REPO}}/docs/PI_INGEST_PAYLOAD_RECOVERY_RUNBOOK.md
After=local-fs.target
RequiresMountsFor=/mnt/ar-local-backup
ConditionPathExists=/etc/ar-local/backup.env

[Service]
Type=oneshot
User={{AR_LOCAL_USER}}
Group={{AR_LOCAL_GROUP}}
WorkingDirectory={{AR_LOCAL_REPO}}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{AR_LOCAL_REPO}}/pi_backup_foundation.py snapshot --config /etc/ar-local/backup.env --repo {{AR_LOCAL_REPO}} --site-repo {{AR_SITE_ROOT}}/.. --data-root {{AR_LOCAL_DATA_ROOT}} --operator systemd-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
