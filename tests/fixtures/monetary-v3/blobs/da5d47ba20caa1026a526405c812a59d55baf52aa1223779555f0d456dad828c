{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_date",
    "core_asset_sha256",
    "details_asset_sha256",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "core_asset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "details_asset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "products": {
      "type": "object",
      "maxProperties": 20000,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^executable_v2_shard_[0-9]{3}$"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:executable-index:v2:draft",
  "$comment": "DRAFT; manifest keys executable_v2_index and executable_v2_shard_NNN. Existing v1 descriptor keys remain unchanged."
}
