{
  "name": "ar-local-rates",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit:payload": "node scripts/audit-public-payload.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --passWithNoTests",
    "test:scripts": "node --test scripts/*.test.mjs",
    "doctor": "expo-doctor",
    "eas-build-pre-install": "node scripts/ensure-firebase-config.mjs",
    "preexport:android": "node scripts/ensure-firebase-config.mjs",
    "export:android": "expo export --platform android --source-maps && node scripts/separate-export-symbols.mjs",
    "preexport:ios": "node scripts/ensure-firebase-config.mjs",
    "export:ios": "expo export --platform ios --source-maps && node scripts/separate-export-symbols.mjs",
    "preexport": "node scripts/clean-export-dir.mjs && node scripts/ensure-firebase-config.mjs",
    "export": "expo export --platform all --source-maps && node scripts/separate-export-symbols.mjs",
    "size:report": "node scripts/report-artifact-sizes.mjs --guard",
    "ci": "npm run doctor && npm run typecheck && npm run lint && npm run test:scripts && npm run test -- --ci && npm run export && npm run size:report",
    "sample": "node scripts/build-sample.mjs",
    "icons": "node scripts/make-icons.mjs",
    "changelog:manifest": "node scripts/build-changelog-manifest.mjs"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
