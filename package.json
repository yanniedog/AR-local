{
  "name": "ar-local",
  "private": true,
  "description": "Local CDR ingest + dashboard (workflow parity with AustralianRates; no Cloudflare)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "wait-for-bots": "node wait_for_bots.mjs",
    "pr:bot-feedback-check": "node scripts/pr-bot-feedback-check.mjs",
    "pr:gates:check": "node scripts/pr-gates-check.mjs",
    "pr:watch-once": "node scripts/pr-watch-once.mjs",
    "pr:queue:drive": "node scripts/pr-queue-drive.mjs",
    "pr:update-branch": "node scripts/pr-update-branch.mjs",
    "pr:bot-feedback-audit": "node scripts/pr-bot-feedback-check.mjs --audit-merged --limit 20",
    "pr:bot-spreadsheet:sync": "node scripts/pr-bot-spreadsheet-sync.mjs",
    "pr:bot-matrix:commit": "node scripts/pr-bot-matrix-commit.mjs",
    "pr:gate-logic:verify": "node scripts/verify-pr-gate-logic.mjs",
    "pr:bot-matrix-commit:verify": "node scripts/verify-pr-bot-matrix-commit.mjs",
    "pr:merge:verify": "node scripts/verify-pr-merge.mjs",
    "close-loop:check": "node scripts/close-loop-check.mjs",
    "ship:closeout:strict": "python ship_closeout_strict.py",
    "verify:local": "python verify_local.py",
    "verify:pi": "python verify_local.py --base-url=http://100.78.28.10/",
    "pi:deploy:verify": "python pi_deploy_verify.py --verify",
    "pi:deploy": "python pi_deploy_verify.py --deploy",
    "pi:deploy:dry-run": "python pi_deploy_verify.py --deploy --dry-run",
    "pi:needs-deploy": "python pi_deploy_verify.py --needs-pi",
    "pi:health:check": "python pi_runtime_health.py --check --check-tailscale",
    "pi:health:heal": "python pi_runtime_health.py --heal",
    "pi:backup:preflight": "python pi_backup_foundation.py preflight",
    "pi:backup:snapshot": "python pi_backup_foundation.py snapshot",
    "pi:backup:gate": "python pi_backup_foundation.py gate",
    "laptop:backup:preflight": "python laptop_pull_backup.py preflight",
    "laptop:backup:latest": "python laptop_pull_backup.py backup-latest",
    "laptop:backup:backfill": "python laptop_pull_backup.py backfill",
    "git:graph-hygiene": "git fetch origin --prune",
    "chief:scan": "node scripts/chief-scan.mjs",
    "agent:auditor": "node scripts/agent-auditor-scan.mjs",
    "github:bot-gates:operator": "node scripts/github-bot-gates-operator.mjs",
    "branch-protection:apply": "node scripts/apply-branch-protection.mjs",
    "repo-merge-settings:apply": "node scripts/apply-repo-merge-settings.mjs",
    "pr:merge": "node scripts/pr-merge.mjs"
  }
}
