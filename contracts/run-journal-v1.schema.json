{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/run-journal-v1.schema.json",
  "title": "AustralianRates RunJournalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_id", "updated_at", "sequence", "stages"],
  "properties": {
    "schema_version": { "const": 1 },
    "generation_id": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "stages": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "attempts", "error", "remote_digest", "retry_at", "updated_at"],
      "properties": {
        "state": { "enum": ["pending", "running", "complete", "retryable_error", "permanent_error"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "error": { "type": ["object", "null"] },
        "remote_digest": { "type": ["string", "null"] },
        "retry_at": { "type": ["string", "null"] },
        "updated_at": { "type": ["string", "null"] }
      }
    }
  }
}
