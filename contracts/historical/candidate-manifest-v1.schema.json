{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanniedog/AR-local/contracts/historical/candidate-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "candidate_id", "coordinate", "lineage", "observation_state", "promotion_eligible", "blockers", "source", "tool", "populations", "quarantine", "unavailable", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "legacy-historical-candidate-v1"},
    "candidate_id": {"type": "string", "pattern": "^hist-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]{4}-r[0-9]{4}-[0-9a-f]{12}$"},
    "coordinate": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "variant_ordinal", "revision_ordinal"],
      "properties": {"date": {"type": "string", "format": "date"}, "variant_ordinal": {"type": "integer", "minimum": 1}, "revision_ordinal": {"type": "integer", "minimum": 1}}
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["relation", "parent_candidate_sha256", "parent_source_manifest_sha256"],
      "properties": {
        "relation": {"enum": ["root_projection", "parallel_projection", "legacy_external_correction"]},
        "parent_candidate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "parent_source_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observation_state": {"const": "partial"},
    "promotion_eligible": {"const": false},
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "source_manifest_sha256", "variant_sha256"],
      "properties": {"snapshot_id": {"type": "string", "minLength": 1}, "source_manifest_sha256": {"$ref": "#/$defs/digest"}, "variant_sha256": {"$ref": "#/$defs/digest"}}
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "python_version", "files"],
      "properties": {
        "commit": {"$ref": "#/$defs/digestOrCommit"}, "python_version": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "populations": {"$ref": "#/$defs/populations"},
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_collision_groups", "semantic_collision_rows", "semantic_duplicate_same_value_groups", "semantic_duplicate_same_value_rows", "semantic_nonunique_rows", "td_no_evidence_terms", "taxonomy_rows", "missing_evidence_rows"],
      "properties": {"semantic_collision_groups": {"type": "integer", "minimum": 0}, "semantic_collision_rows": {"type": "integer", "minimum": 0}, "semantic_duplicate_same_value_groups": {"type": "integer", "minimum": 0}, "semantic_duplicate_same_value_rows": {"type": "integer", "minimum": 0}, "semantic_nonunique_rows": {"type": "integer", "minimum": 0}, "td_no_evidence_terms": {"type": "integer", "minimum": 0}, "taxonomy_rows": {"type": "integer", "minimum": 0}, "missing_evidence_rows": {"type": "integer", "minimum": 0}}
    },
    "unavailable": {"type": "object", "additionalProperties": false, "required": ["register", "providers", "attempts"], "properties": {"register": {"$ref": "#/$defs/unavailable"}, "providers": {"$ref": "#/$defs/unavailable"}, "attempts": {"$ref": "#/$defs/unavailable"}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digestOrCommit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}}},
    "populations": {"type": "object", "additionalProperties": false, "required": ["products", "rates", "failures"], "properties": {"products": {"type": "integer", "minimum": 0}, "rates": {"type": "integer", "minimum": 0}, "failures": {"type": "integer", "minimum": 0}}},
    "unavailable": {"type": "object", "additionalProperties": false, "required": ["state", "value", "reason"], "properties": {"state": {"const": "unavailable"}, "value": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}}
  }
}
