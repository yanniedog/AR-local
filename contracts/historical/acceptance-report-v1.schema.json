{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanniedog/AR-local/contracts/historical/acceptance-report-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract", "status", "snapshot_id", "source", "history", "parity", "safety", "promotion_eligible", "blockers"],
  "properties": {
    "schema_version": {"const": 1}, "contract": {"const": "legacy-historical-acceptance-v1"},
    "status": {"enum": ["accepted_partial_non_promotable", "unverified_partial_non_promotable", "BLOCKED_PRESERVATION_DRIFT", "rejected"]},
    "snapshot_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["manifests_verified_before_source_reads", "preservation_inventory_population", "candidate_input_population", "transient_evidence_population", "full_rehash", "rehash", "preservation_drift"],
      "properties": {
        "manifests_verified_before_source_reads": {"const": true},
        "preservation_inventory_population": {"$ref": "#/$defs/population"},
        "candidate_input_population": {"$ref": "#/$defs/population"},
        "transient_evidence_population": {
          "type": "object", "additionalProperties": false,
          "required": ["files", "bytes", "sqlite_shm_files", "sqlite_shm_bytes", "sqlite_wal_files", "sqlite_wal_bytes"],
          "properties": {
            "files": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0},
            "sqlite_shm_files": {"type": "integer", "minimum": 0}, "sqlite_shm_bytes": {"type": "integer", "minimum": 0},
            "sqlite_wal_files": {"type": "integer", "minimum": 0}, "sqlite_wal_bytes": {"type": "integer", "minimum": 0}
          }
        },
        "full_rehash": {"type": "boolean"},
        "rehash": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "checked_files", "checked_bytes", "verified_files", "verified_bytes", "candidate_inputs_verified"],
          "properties": {
            "state": {"enum": ["not_run", "verified", "drift_detected"]},
            "checked_files": {"type": "integer", "minimum": 0}, "checked_bytes": {"type": "integer", "minimum": 0},
            "verified_files": {"type": "integer", "minimum": 0}, "verified_bytes": {"type": "integer", "minimum": 0},
            "candidate_inputs_verified": {"type": "boolean"}
          }
        },
        "preservation_drift": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/drift"}
        }
      }
    },
    "history": {"type": "object"}, "parity": {"type": "object"}, "safety": {"type": "object"},
    "promotion_eligible": {"const": false},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "population": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "bytes"],
      "properties": {"files": {"type": "integer", "minimum": 0}, "bytes": {"type": "integer", "minimum": 0}}
    },
    "drift": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_bytes", "actual_bytes", "expected_sha256", "actual_sha256", "source_role"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "expected_bytes": {"type": "integer", "minimum": 0}, "actual_bytes": {"type": "integer", "minimum": 0},
        "expected_sha256": {"$ref": "#/$defs/digest"}, "actual_sha256": {"$ref": "#/$defs/digest"},
        "source_role": {"enum": ["sqlite_transient_sidecar", "immutable_candidate_input", "immutable_preservation_evidence"]}
      }
    }
  }
}
