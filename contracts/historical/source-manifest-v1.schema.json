{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanniedog/AR-local/contracts/historical/source-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "snapshot_id", "observation_date", "observation_state", "artifact_set_sha256", "artifacts", "populations", "unavailable", "blockers"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "legacy-historical-source-manifest-v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "observation_date": {"type": "string", "format": "date"},
    "observation_state": {"const": "partial"},
    "artifact_set_sha256": {"$ref": "#/$defs/digest"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "populations": {
      "type": "object", "additionalProperties": false,
      "required": ["products", "rates", "failures"],
      "properties": {"products": {"type": "integer", "minimum": 0}, "rates": {"type": "integer", "minimum": 0}, "failures": {"type": "integer", "minimum": 0}}
    },
    "unavailable": {
      "type": "object", "additionalProperties": false,
      "required": ["register", "providers", "attempts"],
      "properties": {"register": {"$ref": "#/$defs/unavailable"}, "providers": {"$ref": "#/$defs/unavailable"}, "attempts": {"$ref": "#/$defs/unavailable"}}
    },
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1}, "path": {"$ref": "#/$defs/path"},
        "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "unavailable": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "value", "reason"],
      "properties": {"state": {"const": "unavailable"}, "value": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}
    }
  }
}
