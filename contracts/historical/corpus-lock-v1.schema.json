{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanniedog/AR-local/contracts/historical/corpus-lock-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "snapshot_id", "inventory", "critical_population", "candidate_input_population", "immutable_critical_population", "transient_evidence_population", "retained_dates", "gap_entries", "minimum_candidates", "legacy_ledger_records", "additive_ledger_audit", "quarantine", "gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "legacy-historical-corpus-lock-v1"},
    "snapshot_id": {"const": "20260814T202526AEST-pi5-3dc9b4677"},
    "inventory": {"$ref": "#/$defs/artifact"},
    "critical_population": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "bytes", "products", "rates", "failures"],
      "properties": {
        "files": {"const": 1932}, "bytes": {"const": 25586769110},
        "products": {"const": 230852}, "rates": {"const": 1319589},
        "failures": {"const": 8077}
      }
    },
    "candidate_input_population": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "bytes"],
      "properties": {
        "files": {"const": 1495}, "bytes": {"const": 21179877992}
      }
    },
    "immutable_critical_population": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "bytes"],
      "properties": {
        "files": {"const": 1756}, "bytes": {"const": 21280983214}
      }
    },
    "transient_evidence_population": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "bytes", "sqlite_shm_files", "sqlite_shm_bytes", "sqlite_wal_files", "sqlite_wal_bytes", "candidate_input", "reason"],
      "properties": {
        "files": {"const": 176}, "bytes": {"const": 4305785896},
        "sqlite_shm_files": {"const": 88}, "sqlite_shm_bytes": {"const": 9797632},
        "sqlite_wal_files": {"const": 88}, "sqlite_wal_bytes": {"const": 4295988264},
        "candidate_input": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "retained_dates": {"const": 92},
    "gap_entries": {"const": 2},
    "minimum_candidates": {"const": 95},
    "legacy_ledger_records": {"const": 93},
    "additive_ledger_audit": {
      "type": "object", "additionalProperties": false,
      "required": ["changed_dates", "original_files", "original_bytes", "addition_files", "addition_bytes"],
      "properties": {
        "changed_dates": {"const": 57}, "original_files": {"const": 568},
        "original_bytes": {"const": 18177646221}, "addition_files": {"const": 688},
        "addition_bytes": {"const": 147127281}
      }
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_collision_groups", "semantic_collision_rows", "semantic_duplicate_same_value_groups", "semantic_duplicate_same_value_rows", "semantic_nonunique_rows", "td_no_evidence_terms"],
      "properties": {
        "semantic_collision_groups": {"const": 763},
        "semantic_collision_rows": {"const": 1876},
        "semantic_duplicate_same_value_groups": {"const": 95},
        "semantic_duplicate_same_value_rows": {"const": 190},
        "semantic_nonunique_rows": {"const": 2066},
        "td_no_evidence_terms": {"const": 460}
      }
    },
    "gaps": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "status"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "status": {"enum": ["known_gap", "unclassified_gap"]}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
