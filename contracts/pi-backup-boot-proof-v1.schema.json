{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/pi-backup-boot-proof-v1.schema.json",
  "title": "AR-local physically booted recovery proof v1",
  "type": "object",
  "required": [
    "schema_version", "created_at", "plan_document_id", "plan_version",
    "plan_git_commit", "plan_sha256", "plan_raw_sha256", "candidate_code_sha", "operator", "exact_commands", "deviations", "boot_id",
    "backup_device_id", "network", "dashboard", "ingest_timers",
    "storage_identity", "evidence", "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_document_id": {"const": "ARL-OPS-001"},
    "plan_version": {"const": "1.0"},
    "plan_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operator": {"type": "string", "minLength": 1},
    "exact_commands": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "deviations": {"type": "array"},
    "boot_id": {"type": "string", "minLength": 1},
    "backup_device_id": {"type": "string", "minLength": 1},
    "network": {"type": "object"},
    "dashboard": {"type": "object"},
    "ingest_timers": {"type": "object"},
    "storage_identity": {"type": "object"},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }, "additionalProperties": true
      }
    },
    "result": {"const": "PASS"}
  },
  "additionalProperties": true
}
