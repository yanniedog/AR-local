{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/v3/generation-manifest-v3.schema.json",
  "title": "AustralianRates GenerationManifestV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "generation_revision",
    "generation_digest",
    "observation_date",
    "observed_at",
    "observation_state",
    "ledger_state",
    "normalization_version",
    "producer_commit",
    "coverage",
    "prior_ledger_digest",
    "ledger_event_digest",
    "capabilities"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "generation_id": { "type": "string", "pattern": "^gen-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[0-9]{4}-[0-9a-f]{12}$" },
    "generation_revision": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "generation_digest": { "$ref": "#/$defs/digest" },
    "observation_date": { "type": "string", "format": "date" },
    "observed_at": { "type": "string", "format": "date-time" },
    "observation_state": { "enum": ["complete", "partial"] },
    "ledger_state": { "const": "finalized" },
    "normalization_version": { "type": "string", "minLength": 1 },
    "producer_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "coverage": { "$ref": "coverage-v2.schema.json" },
    "prior_ledger_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "ledger_event_digest": { "$ref": "#/$defs/digest" },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "required": ["core"],
      "properties": {
        "core": {
          "allOf": [
            { "$ref": "asset-descriptor-v3.schema.json" },
            {
              "properties": {
                "capability": { "const": "core" },
                "schema_id": {
                  "const": "https://australianrates.app/contracts/v3/canonical-core-v3.schema.json"
                },
                "cohort": { "const": "confirmed-consumer-products" },
                "media_type": { "const": "application/json" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
