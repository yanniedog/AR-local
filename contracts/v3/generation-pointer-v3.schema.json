{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/v3/generation-pointer-v3.schema.json",
  "title": "AustralianRates GenerationPointerV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "contract_sha256",
    "latest_observation",
    "latest_complete"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "generated_at": { "type": "string", "format": "date-time" },
    "contract_sha256": { "$ref": "#/$defs/digest" },
    "latest_observation": { "$ref": "#/$defs/head" },
    "latest_complete": { "$ref": "#/$defs/completeHead" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completeHead": {
      "allOf": [
        { "$ref": "#/$defs/head" },
        {
          "properties": {
            "observation_state": { "const": "complete" }
          }
        }
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "generation_revision",
        "generation_digest",
        "manifest_sha256",
        "observation_date",
        "observation_state",
        "manifest_url"
      ],
      "properties": {
        "generation_id": { "type": "string", "pattern": "^gen-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[0-9]{4}-[0-9a-f]{12}$" },
        "generation_revision": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "generation_digest": { "$ref": "#/$defs/digest" },
        "manifest_sha256": { "$ref": "#/$defs/digest" },
        "observation_date": { "type": "string", "format": "date" },
        "observation_state": { "enum": ["complete", "partial"] },
        "manifest_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/yanniedog/AR-local/releases/download/"
        }
      }
    }
  }
}
