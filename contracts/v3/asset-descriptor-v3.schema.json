{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/v3/asset-descriptor-v3.schema.json",
  "title": "AustralianRates AssetDescriptorV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "media_type",
    "encoding",
    "compressed_bytes",
    "uncompressed_bytes",
    "sha256",
    "url",
    "cohort",
    "capability"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://australianrates\\.app/contracts/v3/[a-z0-9-]+\\.schema\\.json$"
    },
    "media_type": { "enum": ["application/json", "application/schema+json"] },
    "encoding": { "enum": ["gzip", "identity"] },
    "compressed_bytes": { "type": "integer", "minimum": 1 },
    "uncompressed_bytes": { "type": "integer", "minimum": 1 },
    "sha256": { "$ref": "#/$defs/digest" },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/yanniedog/AR-local/releases/download/"
    },
    "cohort": { "type": "string", "minLength": 1 },
    "capability": {
      "enum": [
        "core",
        "facets",
        "search",
        "v1_details_compatibility",
        "detail_index",
        "detail_shard",
        "history_summary",
        "bank_response",
        "spread",
        "rba",
        "exact_product_history",
        "economy"
      ]
    }
  },
  "allOf": [
    { "$ref": "#/$defs/coreLimit" },
    { "$ref": "#/$defs/facetsLimit" },
    { "$ref": "#/$defs/searchLimit" },
    { "$ref": "#/$defs/v1DetailsLimit" },
    { "$ref": "#/$defs/detailIndexLimit" },
    { "$ref": "#/$defs/detailShardLimit" },
    { "$ref": "#/$defs/historySummaryLimit" },
    { "$ref": "#/$defs/bankResponseLimit" },
    { "$ref": "#/$defs/spreadLimit" },
    { "$ref": "#/$defs/rbaLimit" },
    { "$ref": "#/$defs/exactHistoryLimit" },
    { "$ref": "#/$defs/economyLimit" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "coreLimit": {
      "if": { "properties": { "capability": { "const": "core" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 2097152 }, "uncompressed_bytes": { "maximum": 16777216 } } }
    },
    "facetsLimit": {
      "if": { "properties": { "capability": { "const": "facets" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 4194304 }, "uncompressed_bytes": { "maximum": 33554432 } } }
    },
    "searchLimit": {
      "if": { "properties": { "capability": { "const": "search" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 8388608 }, "uncompressed_bytes": { "maximum": 67108864 } } }
    },
    "v1DetailsLimit": {
      "if": { "properties": { "capability": { "const": "v1_details_compatibility" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 8388608 }, "uncompressed_bytes": { "maximum": 100663296 } } }
    },
    "detailIndexLimit": {
      "if": { "properties": { "capability": { "const": "detail_index" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 2097152 }, "uncompressed_bytes": { "maximum": 16777216 } } }
    },
    "detailShardLimit": {
      "if": { "properties": { "capability": { "const": "detail_shard" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 4194304 }, "uncompressed_bytes": { "maximum": 33554432 } } }
    },
    "historySummaryLimit": {
      "if": { "properties": { "capability": { "const": "history_summary" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 8388608 }, "uncompressed_bytes": { "maximum": 67108864 } } }
    },
    "bankResponseLimit": {
      "if": { "properties": { "capability": { "const": "bank_response" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 16777216 }, "uncompressed_bytes": { "maximum": 134217728 } } }
    },
    "spreadLimit": {
      "if": { "properties": { "capability": { "const": "spread" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 8388608 }, "uncompressed_bytes": { "maximum": 67108864 } } }
    },
    "rbaLimit": {
      "if": { "properties": { "capability": { "const": "rba" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 1048576 }, "uncompressed_bytes": { "maximum": 4194304 } } }
    },
    "exactHistoryLimit": {
      "if": { "properties": { "capability": { "const": "exact_product_history" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 33554432 }, "uncompressed_bytes": { "maximum": 268435456 } } }
    },
    "economyLimit": {
      "if": { "properties": { "capability": { "const": "economy" } }, "required": ["capability"] },
      "then": { "properties": { "compressed_bytes": { "maximum": 2097152 }, "uncompressed_bytes": { "maximum": 16777216 } } }
    }
  }
}
