{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/v3/coverage-v2.schema.json",
  "title": "AustralianRates CoverageV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "products_discovered",
    "products_priced",
    "products_consumer_eligible",
    "rate_tiers_eligible",
    "providers_registered",
    "providers_attempted",
    "providers_responded",
    "providers_complete",
    "providers_empty",
    "providers_partial",
    "providers_failed",
    "providers_not_attempted",
    "register_sources_attempted",
    "register_sources_complete",
    "register_provenance_complete",
    "failure_records",
    "corrupt_failure_records",
    "exclusions_by_reason",
    "failure_provenance_complete",
    "reconciliation_status"
  ],
  "properties": {
    "products_discovered": { "$ref": "#/$defs/count" },
    "products_priced": { "$ref": "#/$defs/count" },
    "products_consumer_eligible": { "$ref": "#/$defs/count" },
    "rate_tiers_eligible": { "$ref": "#/$defs/count" },
    "providers_registered": { "$ref": "#/$defs/count" },
    "providers_attempted": { "$ref": "#/$defs/count" },
    "providers_responded": { "$ref": "#/$defs/count" },
    "providers_complete": { "$ref": "#/$defs/count" },
    "providers_empty": { "$ref": "#/$defs/count" },
    "providers_partial": { "$ref": "#/$defs/count" },
    "providers_failed": { "$ref": "#/$defs/count" },
    "providers_not_attempted": { "$ref": "#/$defs/count" },
    "register_sources_attempted": { "type": "integer", "minimum": 1 },
    "register_sources_complete": { "$ref": "#/$defs/count" },
    "register_provenance_complete": { "type": "boolean" },
    "failure_records": { "$ref": "#/$defs/count" },
    "corrupt_failure_records": { "$ref": "#/$defs/count" },
    "exclusions_by_reason": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "failure_provenance_complete": { "type": "boolean" },
    "reconciliation_status": { "enum": ["reconciled", "partial", "failed"] }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 }
  }
}
