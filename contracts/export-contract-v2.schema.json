{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/export-contract-v2.schema.json",
  "title": "AustralianRates ExportContractV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "source_generation_digest",
    "contract_digest",
    "observation_date",
    "observed_at",
    "timezone",
    "normalization_version",
    "ledger_state",
    "observation_state",
    "source_path",
    "completion_marker_path",
    "register_hashes",
    "provider_states",
    "coverage",
    "quarantines",
    "artifacts",
    "prior_ledger_head"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "generation_id": { "type": "string", "pattern": "^obs-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{16}$" },
    "source_generation_digest": { "$ref": "#/$defs/digest" },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "observation_date": { "type": "string", "format": "date" },
    "observed_at": { "type": "string", "format": "date-time" },
    "timezone": { "const": "Australia/Hobart" },
    "normalization_version": { "type": "string", "minLength": 1 },
    "ledger_state": { "const": "provisional" },
    "observation_state": { "enum": ["complete", "partial", "failed"] },
    "source_path": { "$ref": "#/$defs/relativePath" },
    "completion_marker_path": { "$ref": "#/$defs/relativePath" },
    "register_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256"],
        "properties": { "sha256": { "$ref": "#/$defs/digest" } }
      }
    },
    "provider_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerObservation" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "quarantines": { "type": "array", "items": { "type": "object" } },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "prior_ledger_head": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "providerObservation": {
      "type": "object",
      "required": ["provider_uid", "state"],
      "properties": {
        "provider_uid": { "type": "string", "minLength": 1 },
        "state": { "enum": ["complete", "empty", "partial", "failed", "not_attempted"] },
        "failure_records": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "products_discovered",
        "eligible_rate_rows",
        "providers_registered",
        "providers_attempted",
        "providers_complete",
        "providers_partial",
        "providers_failed",
        "failure_records",
        "corrupt_failure_records",
        "unattributed_failure_records",
        "register_sources_attempted",
        "register_sources_complete",
        "register_provenance_complete",
        "failure_provenance_complete",
        "reconciliation_status",
        "unavailable_populations"
      ],
      "properties": {
        "products_discovered": { "type": "integer", "minimum": 0 },
        "eligible_rate_rows": { "type": "integer", "minimum": 0 },
        "providers_registered": { "type": "integer", "minimum": 0 },
        "providers_attempted": { "type": "integer", "minimum": 0 },
        "providers_complete": { "type": "integer", "minimum": 0 },
        "providers_partial": { "type": "integer", "minimum": 0 },
        "providers_failed": { "type": "integer", "minimum": 0 },
        "failure_records": { "type": "integer", "minimum": 0 },
        "corrupt_failure_records": { "type": "integer", "minimum": 0 },
        "unattributed_failure_records": { "type": "integer", "minimum": 0 },
        "register_sources_attempted": { "type": "integer", "minimum": 0 },
        "register_sources_complete": { "type": "integer", "minimum": 0 },
        "register_provenance_complete": { "type": "boolean" },
        "failure_provenance_complete": { "type": "boolean" },
        "reconciliation_status": { "enum": ["reconciled", "partial"] },
        "unavailable_populations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
