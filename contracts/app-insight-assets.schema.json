{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanniedog/AR-local/contracts/app-insight-assets.schema.json",
  "title": "Australian Rates additive insight asset contracts",
  "oneOf": [
    { "$ref": "#/$defs/coverage" },
    { "$ref": "#/$defs/productHistory" },
    { "$ref": "#/$defs/economicOutlook" }
  ],
  "$defs": {
    "coverage": {
      "type": "object",
      "required": ["schema_version", "observed_on", "source", "failure_provenance_complete", "counts", "sections", "provider_failures"],
      "properties": {
        "schema_version": { "const": 1 },
        "observed_on": { "type": "string", "format": "date" },
        "observed_at": { "type": "string", "format": "date-time" },
        "source": { "const": "consumer_data_right_export" },
        "failure_provenance_complete": { "type": "boolean" },
        "source_generated_at": { "type": ["string", "null"] },
        "counts": { "type": "object" },
        "sections": { "type": "object" },
        "provider_failures": { "type": "array", "maxItems": 2000 },
        "providers_attempted": { "type": "integer", "minimum": 0 },
        "providers_succeeded": { "type": "integer", "minimum": 0 },
        "failures": { "type": "array", "maxItems": 2000 }
      },
      "additionalProperties": false
    },
    "productHistory": {
      "type": "object",
      "required": ["schema_version", "run_date", "run_dates", "cohort", "aggregation", "products", "moves", "section_aggregates", "coverage", "core_sha"],
      "properties": {
        "schema_version": { "const": 2 },
        "run_date": { "type": "string", "format": "date" },
        "run_dates": { "type": "array", "maxItems": 2000, "items": { "type": "string", "format": "date" } },
        "cohort": { "$ref": "#/$defs/standardCohort" },
        "aggregation": { "const": "best_advertised_rate_per_product_section" },
        "products": { "type": "object", "maxProperties": 100000 },
        "product_meta": { "type": "object" },
        "moves": { "type": "object" },
        "section_aggregates": { "type": "object" },
        "coverage": { "type": "object" },
        "core_sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "economicOutlook": {
      "type": "object",
      "required": ["schema_version", "kind", "generated_at", "signal_label", "series"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "observed_economic_indicators" },
        "generated_at": { "type": "string", "format": "date-time" },
        "signal_label": { "const": "signal_balance" },
        "series": { "type": "array", "maxItems": 64 }
      },
      "additionalProperties": false
    },
    "standardCohort": {
      "type": "object",
      "required": ["id", "label", "account_class", "composition"],
      "properties": {
        "id": { "const": "standard" },
        "label": { "type": "string" },
        "account_class": { "const": "standard" },
        "composition": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
