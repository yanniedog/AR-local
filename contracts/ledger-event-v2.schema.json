{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/ledger-event-v2.schema.json",
  "title": "AustralianRates LedgerEventV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "ledger_state",
    "observation_state",
    "observation_date",
    "generation_id",
    "parent_generation_id",
    "contract_path",
    "contract_digest",
    "previous_event_digest",
    "finalized_at",
    "event_digest"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "event_type": { "enum": ["observation_finalized", "revision_finalized"] },
    "ledger_state": { "const": "finalized" },
    "observation_state": { "enum": ["complete", "partial", "failed"] },
    "observation_date": { "type": "string", "format": "date" },
    "generation_id": { "$ref": "#/$defs/generation" },
    "parent_generation_id": { "oneOf": [{ "$ref": "#/$defs/generation" }, { "$ref": "#/$defs/legacyParent" }, { "type": "null" }] },
    "parent_event_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "contract_path": { "type": "string", "minLength": 1 },
    "contract_digest": { "$ref": "#/$defs/digest" },
    "previous_event_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "finalized_at": { "type": "string", "format": "date-time" },
    "event_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generation": { "type": "string", "pattern": "^obs-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{16}$" },
    "legacyParent": { "type": "string", "pattern": "^legacy-export-[0-9a-f]{24}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "revision_finalized" } } },
      "then": {
        "required": ["parent_generation_id"],
        "oneOf": [
          {
            "required": ["parent_event_digest"],
            "properties": {
              "parent_generation_id": { "$ref": "#/$defs/generation" },
              "parent_event_digest": { "$ref": "#/$defs/digest" }
            }
          },
          {
            "properties": {
              "parent_generation_id": { "oneOf": [{ "$ref": "#/$defs/generation" }, { "$ref": "#/$defs/legacyParent" }] },
              "parent_event_digest": { "type": "null" }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "parent_generation_id": { "type": "null" },
          "parent_event_digest": { "type": "null" }
        }
      }
    }
  ]
}
