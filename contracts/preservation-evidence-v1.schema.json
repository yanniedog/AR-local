{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanniedog/AR-local/contracts/preservation-evidence-v1.schema.json",
  "title": "AR-local preservation evidence locator v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "storage",
    "retrieval",
    "verification_summary",
    "manifests"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}AEST-pi5-[0-9a-f]{9}$"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "root_placeholder",
        "snapshot_relative_path",
        "retention",
        "offsite_object_locked_copy_status"
      ],
      "properties": {
        "kind": { "const": "operator_controlled_off_repository_snapshot" },
        "root_placeholder": { "const": "<AUSTRALIANRATES_PRESERVATION_ROOT>" },
        "snapshot_relative_path": { "$ref": "#/$defs/nonEmpty" },
        "retention": { "$ref": "#/$defs/nonEmpty" },
        "offsite_object_locked_copy_status": { "enum": ["pending", "verified"] }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_root",
        "inventory_relative_path",
        "procedure",
        "network_required",
        "writes_permitted"
      ],
      "properties": {
        "required_root": { "const": "<AUSTRALIANRATES_PRESERVATION_ROOT>" },
        "inventory_relative_path": { "const": "manifests/preservation-file-inventory.jsonl" },
        "procedure": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "network_required": { "const": false },
        "writes_permitted": { "const": false }
      }
    },
    "verification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "critical_files",
        "critical_bytes",
        "critical_findings",
        "semantic_json_files",
        "semantic_gzipped_json_files",
        "semantic_sqlite_databases",
        "semantic_xlsx_archives",
        "semantic_findings",
        "legacy_ledger_findings",
        "legacy_ledger_exact_restore_match",
        "minimum_free_gib",
        "free_gib_after_snapshot"
      ],
      "properties": {
        "status": { "const": "VERIFIED_RESTORABLE_WITH_LEGACY_LEDGER_QUARANTINE" },
        "critical_files": { "type": "integer", "minimum": 1 },
        "critical_bytes": { "type": "integer", "minimum": 1 },
        "critical_findings": { "const": 0 },
        "semantic_json_files": { "type": "integer", "minimum": 0 },
        "semantic_gzipped_json_files": { "type": "integer", "minimum": 0 },
        "semantic_sqlite_databases": { "type": "integer", "minimum": 0 },
        "semantic_xlsx_archives": { "type": "integer", "minimum": 0 },
        "semantic_findings": { "const": 0 },
        "legacy_ledger_findings": { "type": "integer", "minimum": 0 },
        "legacy_ledger_exact_restore_match": { "const": true },
        "minimum_free_gib": { "type": "number", "minimum": 50 },
        "free_gib_after_snapshot": { "type": "number", "minimum": 50 }
      }
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-semantic-unique-key": "path",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^manifests/[A-Za-z0-9._-]+$"
          },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
