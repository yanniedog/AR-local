{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanniedog/AR-local/contracts/app-payload-v2.schema.json",
  "title": "Australian Rates optional payload v2 manifest",
  "type": "object",
  "required": ["schema_version", "run_date", "generated_at", "base", "capabilities", "files"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_date": { "type": "string", "format": "date" },
    "generated_at": { "type": "string", "format": "date-time" },
    "base": {
      "type": "object",
      "required": ["manifest_schema", "core_sha", "details_sha"],
      "properties": {
        "manifest_schema": { "const": 1 },
        "core_sha": { "$ref": "#/$defs/sha256" },
        "details_sha": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": { "enum": ["product_history", "economic_outlook"] },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "required": ["product_history"],
      "properties": {
        "product_history": { "$ref": "#/$defs/asset" },
        "economic_outlook": {
          "$ref": "#/$defs/asset",
          "properties": {
            "bytes": { "maximum": 2097152 },
            "uncompressed_bytes": { "maximum": 16777216 }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "asset": {
      "type": "object",
      "required": ["name", "sha256", "bytes", "uncompressed_bytes", "encoding", "url"],
      "properties": {
        "name": { "type": "string", "pattern": "^v2-[a-z-]+-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}\\.json\\.gz$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
        "uncompressed_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "encoding": { "const": "gzip" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      },
      "additionalProperties": false
    }
  }
}
