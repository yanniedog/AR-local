{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.example/contracts/rate-conditions-v1.schema.json",
  "title": "Raw rate/tier source disclosures, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSha256", "entries"],
  "properties": {
    "schemaVersion": {"const": 1, "type": "integer"},
    "sourceSha256": {"$ref": "#/$defs/sha"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pointer": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^/[A-Za-z0-9/]+$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rateFamily", "rateIndex", "rateSourcePointer", "sourcePointer", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/sha"},
        "rateFamily": {"enum": ["deposit", "lending"]},
        "rateIndex": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "rateSourcePointer": {"$ref": "#/$defs/pointer"},
        "tierSourcePointer": {"$ref": "#/$defs/pointer"},
        "sourcePointer": {"$ref": "#/$defs/pointer"},
        "text": {"type": "string", "minLength": 1, "maxLength": 16384}
      }
    }
  }
}
