{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subjectId",
    "decision",
    "previousReviewId",
    "reason"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "rejected",
        "revoked"
      ]
    },
    "previousReviewId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:executable-negative-review:v2:draft"
}
