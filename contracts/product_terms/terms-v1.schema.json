{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:product-terms:v1",
  "title": "Public product terms evidence, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_key", "identity_sha256", "documents", "clauses", "revisions", "coverage", "changes"],
  "properties": {
    "schema_version": {"const": 1},
    "product_key": {"type": "string", "minLength": 1},
    "identity_sha256": {"$ref": "#/$defs/sha"},
    "documents": {"type": "array", "items": {"$ref": "#/$defs/document"}},
    "clauses": {"type": "array", "items": {"$ref": "#/$defs/clause"}},
    "revisions": {"type": "array", "items": {"$ref": "#/$defs/revision"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableText": {"type": ["string", "null"]},
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["document_version_id", "source_url", "content_sha256", "media_type", "byte_size", "observed_at", "effective_from", "effective_to"],
      "properties": {
        "document_version_id": {"$ref": "#/$defs/sha"},
        "source_url": {"type": "string", "pattern": "^https?://"},
        "content_sha256": {"$ref": "#/$defs/sha"},
        "media_type": {"type": "string"},
        "byte_size": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "effective_from": {"$ref": "#/$defs/nullableText"},
        "effective_to": {"$ref": "#/$defs/nullableText"}
      }
    },
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["clause_id", "document_version_id", "locator", "text", "disposition"],
      "properties": {
        "clause_id": {"$ref": "#/$defs/sha"},
        "document_version_id": {"$ref": "#/$defs/sha"},
        "locator": {
          "type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": {"page": {"type": "integer", "minimum": 1}, "section": {"type": "string"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "excerpt_truncated": {"type": "boolean"},
        "disposition": {"enum": ["uninterpreted", "interpreted", "not_applicable"]},
        "reason": {"type": "string"}
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["product_key", "tier", "package", "cohort", "effective_from", "effective_to"],
      "properties": {
        "product_key": {"type": "string", "minLength": 1},
        "tier": {"$ref": "#/$defs/nullableText"},
        "package": {"$ref": "#/$defs/nullableText"},
        "cohort": {"$ref": "#/$defs/nullableText"},
        "effective_from": {"$ref": "#/$defs/nullableText"},
        "effective_to": {"$ref": "#/$defs/nullableText"}
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["term_revision_id", "parameter_key", "value", "unit", "applicability", "clause_ids", "rule_set_id", "status", "observed_at"],
      "properties": {
        "term_revision_id": {"$ref": "#/$defs/sha"},
        "parameter_key": {"type": "string", "minLength": 1},
        "value": {},
        "unit": {"$ref": "#/$defs/nullableText"},
        "applicability": {"$ref": "#/$defs/applicability"},
        "clause_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
        "rule_set_id": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "status": {"const": "validated"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "expected", "observed"],
      "properties": {
        "status": {"enum": ["unknown", "pending", "partial", "complete", "failed", "not_applicable"]},
        "expected": {"type": ["integer", "null"], "minimum": 0},
        "observed": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery", "acquisition", "extraction", "interpretation", "calculation", "gaps"],
      "properties": {
        "discovery": {"$ref": "#/$defs/stage"}, "acquisition": {"$ref": "#/$defs/stage"},
        "extraction": {"$ref": "#/$defs/stage"}, "interpretation": {"$ref": "#/$defs/stage"},
        "calculation": {"$ref": "#/$defs/stage"}, "gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["term_change_id", "before_revision_id", "after_revision_id", "kind", "observed_at"],
      "properties": {
        "term_change_id": {"$ref": "#/$defs/sha"},
        "before_revision_id": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "after_revision_id": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "kind": {"enum": ["added", "changed", "removed", "extraction_corrected"]},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
