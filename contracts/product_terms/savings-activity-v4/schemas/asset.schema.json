{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:savings-activity-wire4-draft:asset",
  "$comment": "DRAFT ONLY; root byte freeze pending; technical contract, no bank approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "productKey",
    "routing",
    "approvalPolicy",
    "identitySha256",
    "subjects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "capability": {
      "const": "savings_activity_calculation"
    },
    "productKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "routing": {
      "$ref": "urn:ar-local:savings-activity-wire4-draft:common#/$defs/routing"
    },
    "approvalPolicy": {
      "const": "as_of_adopted_edition"
    },
    "identitySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "approval"
        ],
        "properties": {
          "subject": {
            "$ref": "urn:ar-local:savings-activity-wire4-draft:subject"
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subjectId",
              "capability",
              "reviewId",
              "reviewEvidenceSha256",
              "benchmarkResultSha256",
              "authorityGraphSha256",
              "reviewedAt",
              "checks"
            ],
            "properties": {
              "subjectId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "capability": {
                "const": "savings_activity_calculation"
              },
              "reviewId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reviewEvidenceSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "benchmarkResultSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "authorityGraphSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_alignment",
                  "historical_coverage",
                  "scope_coverage",
                  "input_bindings",
                  "rule_semantics",
                  "rate_schedule",
                  "material_terms",
                  "fee_coverage",
                  "posting_and_residue",
                  "benchmark"
                ],
                "properties": {
                  "source_alignment": {
                    "const": "verified"
                  },
                  "historical_coverage": {
                    "const": "verified"
                  },
                  "scope_coverage": {
                    "const": "verified"
                  },
                  "input_bindings": {
                    "const": "verified"
                  },
                  "rule_semantics": {
                    "const": "verified"
                  },
                  "rate_schedule": {
                    "const": "verified"
                  },
                  "material_terms": {
                    "const": "verified"
                  },
                  "fee_coverage": {
                    "const": "verified"
                  },
                  "posting_and_residue": {
                    "const": "verified"
                  },
                  "benchmark": {
                    "const": "verified"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
