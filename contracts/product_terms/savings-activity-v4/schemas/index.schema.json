{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:savings-activity-wire4-draft:index",
  "$comment": "DRAFT ONLY; root byte freeze pending; technical contract, no bank approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "run_date",
    "core_asset_sha256",
    "details_asset_sha256",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "capability": {
      "const": "savings_activity_calculation"
    },
    "run_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
    },
    "core_asset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "details_asset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "products": {
      "type": "object",
      "maxProperties": 20000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^monetary_v4_savings_activity_calculation_shard_[0-9]{3}$"
      }
    }
  }
}
