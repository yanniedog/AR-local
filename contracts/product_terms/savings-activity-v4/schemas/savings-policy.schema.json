{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:savings-activity-wire4-draft:savings-policy",
  "$comment": "DRAFT ONLY; root byte freeze pending; technical contract, no bank approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "currency",
    "maxHorizonDays",
    "calculationMode",
    "initialUnpostedAccrual",
    "openingClearedFunds",
    "postingInventory",
    "externalMovements",
    "withholding",
    "bonus",
    "intro",
    "offset",
    "linkedAccounts",
    "fees",
    "intervals",
    "eligibility",
    "inputDefinitions"
  ],
  "properties": {
    "kind": {
      "const": "aud_savings_activity_period_v1"
    },
    "currency": {
      "const": "AUD"
    },
    "maxHorizonDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    },
    "calculationMode": {
      "const": "historical_holding_period"
    },
    "initialUnpostedAccrual": {
      "const": "zero_user_confirmed"
    },
    "openingClearedFunds": {
      "const": "confirm_all_cleared_when_any_interval_uses_cleared_only"
    },
    "postingInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "toExclusive",
        "coverage",
        "boundary",
        "calendarAdjustment",
        "rule",
        "dueDates",
        "evidenceIds"
      ],
      "properties": {
        "from": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared7"
        },
        "toExclusive": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared7"
        },
        "coverage": {
          "const": "all_source_due_dates"
        },
        "boundary": {
          "const": "from_inclusive_to_exclusive"
        },
        "calendarAdjustment": {
          "const": "none_source_declared"
        },
        "rule": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "evidenceIds"
              ],
              "properties": {
                "kind": {
                  "const": "calendar_month_end"
                },
                "evidenceIds": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sourceFrom",
                "sourceToExclusive",
                "sourceDueDates",
                "completenessEvidenceIds"
              ],
              "properties": {
                "kind": {
                  "const": "explicit_dated_source_schedule"
                },
                "sourceFrom": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared7"
                },
                "sourceToExclusive": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared7"
                },
                "sourceDueDates": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared9"
                },
                "completenessEvidenceIds": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
                }
              }
            }
          ]
        },
        "dueDates": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared9"
        },
        "evidenceIds": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
        }
      }
    },
    "externalMovements": {
      "const": "none_user_confirmed"
    },
    "withholding": {
      "const": "none_user_confirmed_before_tax"
    },
    "bonus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "componentId",
        "allocation",
        "tiers",
        "assessment",
        "evidenceIds",
        "fieldEvidenceIds"
      ],
      "properties": {
        "kind": {
          "const": "activity_additive"
        },
        "componentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "allocation": {
          "enum": [
            "marginal",
            "whole_balance"
          ]
        },
        "tiers": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared8"
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessmentKey",
            "accountRole",
            "from",
            "toExclusive",
            "appliesFrom",
            "appliesToExclusive",
            "dateBasis",
            "settlement",
            "authorityId",
            "metrics",
            "rule",
            "fieldEvidenceIds"
          ],
          "properties": {
            "assessmentKey": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "accountRole": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "from": {
              "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared6"
            },
            "toExclusive": {
              "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared6"
            },
            "appliesFrom": {
              "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared6"
            },
            "appliesToExclusive": {
              "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared6"
            },
            "dateBasis": {
              "enum": [
                "processed",
                "transaction"
              ]
            },
            "settlement": {
              "const": "settled_only"
            },
            "authorityId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "metrics": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "kind",
                      "field",
                      "includedClassifications",
                      "excludedClassifications",
                      "classificationCoverage",
                      "evidenceIds"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "kind": {
                        "const": "deposit_total"
                      },
                      "field": {
                        "const": "activity_deposit_total"
                      },
                      "includedClassifications": {
                        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared13"
                      },
                      "excludedClassifications": {
                        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared12"
                      },
                      "classificationCoverage": {
                        "const": "reviewed_complete_for_metric"
                      },
                      "evidenceIds": {
                        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "kind",
                      "field",
                      "includedClassifications",
                      "excludedClassifications",
                      "classificationCoverage",
                      "evidenceIds"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,63}$"
                      },
                      "kind": {
                        "const": "withdrawal_count"
                      },
                      "field": {
                        "const": "activity_withdrawal_count"
                      },
                      "includedClassifications": {
                        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared13"
                      },
                      "excludedClassifications": {
                        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared12"
                      },
                      "classificationCoverage": {
                        "const": "reviewed_complete_for_metric"
                      },
                      "evidenceIds": {
                        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                      }
                    }
                  }
                ]
              }
            },
            "rule": {
              "oneOf": [
                {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared2"
                },
                {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared3"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "op",
                    "rules"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$"
                    },
                    "op": {
                      "enum": [
                        "and",
                        "or"
                      ]
                    },
                    "rules": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared2"
                          },
                          {
                            "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared3"
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "fieldEvidenceIds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assessmentWindow",
                "activityAccountRole",
                "activityDateBasis",
                "settlementPolicy",
                "classificationInventory",
                "metricThresholds",
                "bonusApplication"
              ],
              "properties": {
                "assessmentWindow": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                },
                "activityAccountRole": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                },
                "activityDateBasis": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                },
                "settlementPolicy": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                },
                "classificationInventory": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                },
                "metricThresholds": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                },
                "bonusApplication": {
                  "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
                }
              }
            }
          }
        },
        "evidenceIds": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
        },
        "fieldEvidenceIds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bonusRates",
            "rateComponents",
            "activityExclusions"
          ],
          "properties": {
            "bonusRates": {
              "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
            },
            "rateComponents": {
              "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
            },
            "activityExclusions": {
              "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
            }
          }
        }
      }
    },
    "intro": {
      "const": "none_source_declared"
    },
    "offset": {
      "const": "none_source_declared"
    },
    "linkedAccounts": {
      "const": "none_source_declared"
    },
    "fees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "deferredObligations",
        "inventory",
        "evidenceIds"
      ],
      "properties": {
        "coverage": {
          "const": "reviewed_complete_no_fees"
        },
        "deferredObligations": {
          "const": "none_source_declared"
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "categoryId",
              "state",
              "evidenceIds"
            ],
            "properties": {
              "categoryId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "state": {
                "const": "none_applicable"
              },
              "evidenceIds": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              }
            }
          }
        },
        "evidenceIds": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
        }
      }
    },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "toExclusive",
          "authorityId",
          "kind",
          "rateMeaning",
          "allocation",
          "tiers",
          "interest",
          "fieldEvidenceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "from": {
            "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared7"
          },
          "toExclusive": {
            "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared7"
          },
          "authorityId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "const": "base"
          },
          "rateMeaning": {
            "const": "additive"
          },
          "allocation": {
            "enum": [
              "marginal",
              "whole_balance"
            ]
          },
          "tiers": {
            "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared8"
          },
          "interest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dayCount",
              "balanceBasis",
              "eventOrder",
              "dailyRateRounding",
              "dailyAccrualScale",
              "accrualRounding",
              "dailyAccrualRounding",
              "postingRounding",
              "postingResidue",
              "postingDestination",
              "postingCalendar",
              "postingDates",
              "depositSettlementBasis",
              "evidenceIds"
            ],
            "properties": {
              "dayCount": {
                "const": "actual_365_fixed"
              },
              "balanceBasis": {
                "const": "closing_balance_before_posted_interest"
              },
              "eventOrder": {
                "const": "ordered_events_then_accrual_then_posting"
              },
              "dailyRateRounding": {
                "oneOf": [
                  {
                    "const": null
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "scale",
                      "unit",
                      "mode"
                    ],
                    "properties": {
                      "scale": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 12
                      },
                      "unit": {
                        "enum": [
                          "fraction",
                          "percent"
                        ]
                      },
                      "mode": {
                        "enum": [
                          "half_up",
                          "half_even",
                          "toward_zero"
                        ]
                      }
                    }
                  }
                ]
              },
              "dailyAccrualScale": {
                "oneOf": [
                  {
                    "const": null
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  }
                ]
              },
              "accrualRounding": {
                "enum": [
                  "half_up",
                  "half_even",
                  "toward_zero"
                ]
              },
              "dailyAccrualRounding": {
                "enum": [
                  "aggregate",
                  "per_tier"
                ]
              },
              "postingRounding": {
                "enum": [
                  "half_up",
                  "half_even",
                  "toward_zero"
                ]
              },
              "postingResidue": {
                "const": "discard_with_rounding_adjustment"
              },
              "postingDestination": {
                "const": "same_account"
              },
              "postingCalendar": {
                "const": "explicit_calendar_dates_no_business_adjustment"
              },
              "postingDates": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared9"
              },
              "depositSettlementBasis": {
                "enum": [
                  "cleared_only",
                  "cleared_and_uncleared"
                ]
              },
              "evidenceIds": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              }
            }
          },
          "fieldEvidenceIds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rates",
              "allocation",
              "dayCount",
              "balanceBasis",
              "eventOrder",
              "dailyRateRounding",
              "dailyAccrualRounding",
              "postingRounding",
              "postingResidue",
              "postingDates",
              "postingDestination",
              "depositSettlementBasis",
              "activityExclusions",
              "noOffsetLinkedAccounts",
              "feeCoverage",
              "noDeferredObligations"
            ],
            "properties": {
              "rates": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "allocation": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "dayCount": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "balanceBasis": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "eventOrder": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "dailyRateRounding": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "dailyAccrualRounding": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "postingRounding": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "postingResidue": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "postingDates": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "postingDestination": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "depositSettlementBasis": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "noOffsetLinkedAccounts": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "feeCoverage": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "noDeferredObligations": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              },
              "activityExclusions": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
              }
            }
          }
        }
      }
    },
    "eligibility": {
      "$ref": "urn:ar-local:savings-activity-wire4-draft:common#/$defs/rule"
    },
    "inputDefinitions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type",
          "unit",
          "binding",
          "evidenceIds"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,179}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "type": {
            "enum": [
              "decimal",
              "date",
              "text",
              "boolean"
            ]
          },
          "unit": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "const": null
              }
            ]
          },
          "binding": {
            "enum": [
              "customer_fact",
              "opening_balance",
              "calculation_start_date",
              "calculation_end_date"
            ]
          },
          "evidenceIds": {
            "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
          }
        }
      }
    }
  }
}
