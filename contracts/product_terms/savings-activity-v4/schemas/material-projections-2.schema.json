{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:savings-activity-wire4-draft:material-projections-2",
  "$comment": "Closed per-field source material projection draft.",
  "$defs": {
    "postingDates": {
      "if": {
        "properties": {
          "field": {
            "const": "postingDates"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "postingInventory",
              "postingCalendar"
            ],
            "properties": {
              "postingInventory": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "toExclusive",
                  "coverage",
                  "boundary",
                  "calendarAdjustment",
                  "rule",
                  "dueDates"
                ],
                "properties": {
                  "from": {
                    "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared6"
                  },
                  "toExclusive": {
                    "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared6"
                  },
                  "coverage": {
                    "const": "all_source_due_dates"
                  },
                  "boundary": {
                    "const": "from_inclusive_to_exclusive"
                  },
                  "calendarAdjustment": {
                    "const": "none_source_declared"
                  },
                  "rule": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "calendar_month_end"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "sourceFrom",
                          "sourceToExclusive",
                          "sourceDueDates"
                        ],
                        "properties": {
                          "kind": {
                            "const": "explicit_dated_source_schedule"
                          },
                          "sourceFrom": {
                            "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared6"
                          },
                          "sourceToExclusive": {
                            "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared6"
                          },
                          "sourceDueDates": {
                            "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared7"
                          }
                        }
                      }
                    ]
                  },
                  "dueDates": {
                    "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared7"
                  }
                }
              },
              "postingCalendar": {
                "const": "explicit_calendar_dates_no_business_adjustment"
              }
            }
          }
        }
      }
    },
    "postingDestination": {
      "if": {
        "properties": {
          "field": {
            "const": "postingDestination"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "postingDestination"
            ],
            "properties": {
              "postingDestination": {
                "const": "same_account"
              }
            }
          }
        }
      }
    },
    "postingResidue": {
      "if": {
        "properties": {
          "field": {
            "const": "postingResidue"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amountUnit",
              "postingResidue"
            ],
            "properties": {
              "amountUnit": {
                "const": "AUD"
              },
              "postingResidue": {
                "const": "discard_with_rounding_adjustment"
              }
            }
          }
        }
      }
    },
    "postingRounding": {
      "if": {
        "properties": {
          "field": {
            "const": "postingRounding"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amountUnit",
              "postingScale",
              "postingRounding"
            ],
            "properties": {
              "amountUnit": {
                "const": "AUD"
              },
              "postingScale": {
                "const": 2
              },
              "postingRounding": {
                "enum": [
                  "half_up",
                  "half_even",
                  "toward_zero"
                ]
              }
            }
          }
        }
      }
    },
    "rates": {
      "if": {
        "properties": {
          "field": {
            "const": "rates"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "currency",
              "rateUnit",
              "amountUnit",
              "kind",
              "rateMeaning",
              "tiers"
            ],
            "properties": {
              "currency": {
                "const": "AUD"
              },
              "rateUnit": {
                "const": "fraction_per_year"
              },
              "amountUnit": {
                "const": "AUD"
              },
              "kind": {
                "const": "base"
              },
              "rateMeaning": {
                "const": "additive"
              },
              "tiers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "upperInclusive",
                    "annualRate"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "upperInclusive": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$"
                        },
                        {
                          "const": null
                        }
                      ]
                    },
                    "annualRate": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,12})?$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "assessmentWindow": {
      "if": {
        "properties": {
          "field": {
            "const": "assessmentWindow"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "toExclusive"
            ],
            "properties": {
              "from": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared5"
              },
              "toExclusive": {
                "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared5"
              }
            }
          }
        }
      }
    },
    "activityAccountRole": {
      "if": {
        "properties": {
          "field": {
            "const": "activityAccountRole"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accountRole"
            ],
            "properties": {
              "accountRole": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            }
          }
        }
      }
    },
    "activityDateBasis": {
      "if": {
        "properties": {
          "field": {
            "const": "activityDateBasis"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dateBasis"
            ],
            "properties": {
              "dateBasis": {
                "enum": [
                  "processed",
                  "transaction"
                ]
              }
            }
          }
        }
      }
    },
    "settlementPolicy": {
      "if": {
        "properties": {
          "field": {
            "const": "settlementPolicy"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "settlement"
            ],
            "properties": {
              "settlement": {
                "const": "settled_only"
              }
            }
          }
        }
      }
    },
    "classificationInventory": {
      "if": {
        "properties": {
          "field": {
            "const": "classificationInventory"
          }
        }
      },
      "then": {
        "properties": {
          "material": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metrics"
            ],
            "properties": {
              "metrics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "kind",
                        "field",
                        "includedClassifications",
                        "excludedClassifications",
                        "classificationCoverage"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,63}$"
                        },
                        "kind": {
                          "const": "deposit_total"
                        },
                        "field": {
                          "const": "activity_deposit_total"
                        },
                        "includedClassifications": {
                          "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared10"
                        },
                        "excludedClassifications": {
                          "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared9"
                        },
                        "classificationCoverage": {
                          "const": "reviewed_complete_for_metric"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "kind",
                        "field",
                        "includedClassifications",
                        "excludedClassifications",
                        "classificationCoverage"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,63}$"
                        },
                        "kind": {
                          "const": "withdrawal_count"
                        },
                        "field": {
                          "const": "activity_withdrawal_count"
                        },
                        "includedClassifications": {
                          "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared10"
                        },
                        "excludedClassifications": {
                          "$ref": "urn:ar-local:savings-activity-wire4-draft:material-field-primitives-1#/$defs/shared9"
                        },
                        "classificationCoverage": {
                          "const": "reviewed_complete_for_metric"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
