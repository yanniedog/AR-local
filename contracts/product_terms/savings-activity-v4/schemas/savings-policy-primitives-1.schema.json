{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1",
  "$comment": "Shared closed draft primitives; no source approval.",
  "$defs": {
    "shared1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "upperInclusive",
        "annualRate",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "upperInclusive": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,2})?$"
            },
            {
              "const": null
            }
          ]
        },
        "annualRate": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,14})(\\.[0-9]{1,12})?$"
        },
        "evidenceIds": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared11"
        }
      }
    },
    "shared2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "op",
        "field",
        "comparison",
        "expected",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "op": {
          "const": "compare"
        },
        "field": {
          "const": "activity_deposit_total"
        },
        "comparison": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "unit"
          ],
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?$"
            },
            "unit": {
              "const": "AUD"
            }
          }
        },
        "evidenceIds": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
        }
      }
    },
    "shared3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "op",
        "field",
        "comparison",
        "expected",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "op": {
          "const": "compare"
        },
        "field": {
          "const": "activity_withdrawal_count"
        },
        "comparison": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value",
            "unit"
          ],
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,3})$"
            },
            "unit": {
              "const": "count"
            }
          }
        },
        "evidenceIds": {
          "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared10"
        }
      }
    },
    "shared6": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date",
      "maxLength": 10
    },
    "shared7": {
      "type": "string",
      "format": "date",
      "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
    },
    "shared8": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared1"
      }
    },
    "shared9": {
      "type": "array",
      "minItems": 0,
      "maxItems": 366,
      "items": {
        "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy-primitives-1#/$defs/shared7"
      },
      "uniqueItems": true
    },
    "shared10": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "shared11": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    },
    "shared12": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true
    },
    "shared13": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "uniqueItems": true
    }
  }
}
