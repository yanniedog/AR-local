{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:savings-activity-wire4-draft:subject",
  "$comment": "DRAFT ONLY; root byte freeze pending; technical contract, no bank approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "kind",
    "adapterVersion",
    "evaluatorVersion",
    "id",
    "scopeId",
    "scope",
    "routing",
    "authorityGraph",
    "policy",
    "documentVersionIds",
    "termRevisionIds",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "capability": {
      "const": "savings_activity_calculation"
    },
    "kind": {
      "const": "aud_savings_activity_period_v1"
    },
    "adapterVersion": {
      "const": "aud-savings-activity-v1"
    },
    "evaluatorVersion": {
      "const": "product-terms-engine-v9"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scopeId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "$ref": "urn:ar-local:savings-activity-wire4-draft:common#/$defs/scope"
    },
    "routing": {
      "$ref": "urn:ar-local:savings-activity-wire4-draft:common#/$defs/routing"
    },
    "authorityGraph": {
      "$ref": "urn:ar-local:savings-activity-wire4-draft:authority-graph"
    },
    "policy": {
      "$ref": "urn:ar-local:savings-activity-wire4-draft:savings-policy"
    },
    "documentVersionIds": {
      "$ref": "#/$defs/shared1"
    },
    "termRevisionIds": {
      "$ref": "#/$defs/shared1"
    },
    "evidence": {
      "$ref": "urn:ar-local:savings-activity-wire4-draft:common#/$defs/evidence"
    }
  },
  "$defs": {
    "shared1": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "uniqueItems": true
    }
  }
}
