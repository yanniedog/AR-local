{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:savings-activity-wire4-draft:namespace",
  "$comment": "DRAFT ONLY; root byte freeze pending; technical contract, no bank approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "savings_activity_calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "shards"
          ],
          "properties": {
            "index": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "bytes",
                "sha256"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 180,
                  "pattern": "^monetary_v4_savings_activity_calculation_index-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}\\.json\\.gz$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 524288
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "shards": {
              "type": "object",
              "maxProperties": 999,
              "propertyNames": {
                "type": "string",
                "pattern": "^monetary_v4_savings_activity_calculation_shard_[0-9]{3}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 180,
                    "pattern": "^monetary_v4_savings_activity_calculation_shard_[0-9]{3}-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}\\.json\\.gz$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 524288
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
