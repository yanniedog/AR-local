{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:monetary-wire3-draft:authority-graph",
  "$comment": "DRAFT ONLY. No freeze, bank approval or runtime adoption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identitySha256",
    "members",
    "authorities",
    "supersessions",
    "completedPeriod"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "identitySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "bytes",
          "decodedBytes",
          "encoding",
          "kind"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "decodedBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "encoding": {
            "enum": [
              "identity",
              "gzip"
            ]
          },
          "kind": {
            "enum": [
              "source_document",
              "observation_manifest",
              "core",
              "details",
              "raw_source",
              "coverage_proof"
            ]
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scope",
              "from",
              "toExclusive",
              "evidenceIds",
              "fieldCoverage",
              "kind",
              "observations",
              "coverageProof"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "scope": {
                "$ref": "urn:ar-local:monetary-wire3-draft:common#/$defs/scope"
              },
              "from": {
                "type": "string",
                "format": "date",
                "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
              },
              "toExclusive": {
                "type": "string",
                "format": "date",
                "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
              },
              "evidenceIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "uniqueItems": true
              },
              "fieldCoverage": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "from",
                    "toExclusive",
                    "postingEventDates",
                    "evidenceIds"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "rates",
                        "allocation",
                        "dayCount",
                        "balanceBasis",
                        "eventOrder",
                        "dailyRateRounding",
                        "dailyAccrualRounding",
                        "postingRounding",
                        "postingResidue",
                        "postingDates",
                        "postingDestination",
                        "depositSettlementBasis",
                        "noBonusIntro",
                        "noOffsetLinkedAccounts",
                        "feeCoverage",
                        "noDeferredObligations",
                        "eligibility"
                      ]
                    },
                    "from": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                    },
                    "toExclusive": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                    },
                    "postingEventDates": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 366,
                      "items": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                      },
                      "uniqueItems": true
                    },
                    "evidenceIds": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "kind": {
                "const": "retained_observation"
              },
              "observations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 366,
                "items": {
                  "$ref": "urn:ar-local:monetary-wire3-draft:common#/$defs/snapshot"
                }
              },
              "coverageProof": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "basis",
                  "from",
                  "toExclusive",
                  "evidenceIds"
                ],
                "properties": {
                  "basis": {
                    "enum": [
                      "dated_source_policy",
                      "complete_daily_observations"
                    ]
                  },
                  "from": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                  },
                  "toExclusive": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                  },
                  "evidenceIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scope",
              "from",
              "toExclusive",
              "evidenceIds",
              "fieldCoverage",
              "kind",
              "documentVersionIds",
              "documentSha256s",
              "datedRateAndPolicyClauseIds",
              "observedRateRows"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "scope": {
                "$ref": "urn:ar-local:monetary-wire3-draft:common#/$defs/scope"
              },
              "from": {
                "type": "string",
                "format": "date",
                "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
              },
              "toExclusive": {
                "type": "string",
                "format": "date",
                "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
              },
              "evidenceIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "uniqueItems": true
              },
              "fieldCoverage": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "from",
                    "toExclusive",
                    "postingEventDates",
                    "evidenceIds"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "rates",
                        "allocation",
                        "dayCount",
                        "balanceBasis",
                        "eventOrder",
                        "dailyRateRounding",
                        "dailyAccrualRounding",
                        "postingRounding",
                        "postingResidue",
                        "postingDates",
                        "postingDestination",
                        "depositSettlementBasis",
                        "noBonusIntro",
                        "noOffsetLinkedAccounts",
                        "feeCoverage",
                        "noDeferredObligations",
                        "eligibility"
                      ]
                    },
                    "from": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                    },
                    "toExclusive": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                    },
                    "postingEventDates": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 366,
                      "items": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
                      },
                      "uniqueItems": true
                    },
                    "evidenceIds": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "kind": {
                "const": "dated_official_clause"
              },
              "documentVersionIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "uniqueItems": true
              },
              "documentSha256s": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "uniqueItems": true
              },
              "datedRateAndPolicyClauseIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "uniqueItems": true
              },
              "observedRateRows": {
                "const": false
              }
            }
          }
        ]
      }
    },
    "supersessions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supersededAuthorityId",
          "selectedAuthorityId",
          "from",
          "toExclusive",
          "evidenceIds"
        ],
        "properties": {
          "supersededAuthorityId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "selectedAuthorityId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
          },
          "toExclusive": {
            "type": "string",
            "format": "date",
            "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "completedPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asOf",
        "completedThroughExclusive",
        "timezone",
        "basis",
        "sourceSnapshotSha256",
        "evidenceIds"
      ],
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "completedThroughExclusive": {
          "type": "string",
          "format": "date",
          "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
        },
        "timezone": {
          "enum": [
            "Australia/Sydney",
            "Australia/Hobart"
          ]
        },
        "basis": {
          "const": "reviewed_data_completeness"
        },
        "sourceSnapshotSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
