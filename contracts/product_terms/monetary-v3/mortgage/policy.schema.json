{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:monetary-mortgage-draft:policy",
  "$comment": "UNFROZEN TECHNICAL DRAFT. No banking authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "currency",
    "mode",
    "maxHorizonDays",
    "authorityIds",
    "annualRate",
    "interestBearing",
    "allocation",
    "paymentPhase",
    "paymentRounding",
    "accruedSettlement",
    "dayCount",
    "dailyRateRounding",
    "dailyAccrualScale",
    "accrualRounding",
    "postingRounding",
    "postingResidue",
    "postingInventory",
    "obligationCalendar",
    "openingState",
    "excludedPeriodEffects",
    "fees",
    "eligibility",
    "inputDefinitions",
    "fieldEvidenceIds"
  ],
  "properties": {
    "kind": {
      "const": "aud_mortgage_confirmed_obligations_v1"
    },
    "currency": {
      "const": "AUD"
    },
    "mode": {
      "const": "historical_confirmed_obligations"
    },
    "maxHorizonDays": {
      "const": 366
    },
    "authorityIds": {
      "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/hashes"
    },
    "annualRate": {
      "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/rate"
    },
    "interestBearing": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "enum": [
          "principal",
          "postedInterest",
          "accruedInterest",
          "capitalizedCharges",
          "otherDebt"
        ]
      },
      "uniqueItems": true
    },
    "allocation": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "enum": [
          "principal",
          "postedInterest",
          "accruedInterest",
          "capitalizedCharges",
          "otherDebt"
        ]
      },
      "uniqueItems": true
    },
    "paymentPhase": {
      "enum": [
        "before_accrual",
        "after_accrual"
      ]
    },
    "paymentRounding": {
      "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/rounding"
    },
    "accruedSettlement": {
      "const": "round_before_each_payment"
    },
    "dayCount": {
      "const": "actual_365_fixed"
    },
    "dailyRateRounding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale",
            "unit",
            "mode"
          ],
          "properties": {
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "unit": {
              "enum": [
                "fraction",
                "percent"
              ]
            },
            "mode": {
              "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/rounding"
            }
          }
        }
      ]
    },
    "dailyAccrualScale": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      ]
    },
    "accrualRounding": {
      "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/rounding"
    },
    "postingRounding": {
      "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/rounding"
    },
    "postingResidue": {
      "const": "round_component_then_transfer_all_to_posted_debt"
    },
    "postingInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "boundary",
        "calendarAdjustment",
        "dueDates",
        "coverage"
      ],
      "properties": {
        "rule": {
          "const": "calendar_month_end"
        },
        "boundary": {
          "const": "from_inclusive_to_exclusive"
        },
        "calendarAdjustment": {
          "const": "none_source_declared"
        },
        "dueDates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 13,
          "items": {
            "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/date"
          }
        },
        "coverage": {
          "const": "all_source_due_dates"
        }
      }
    },
    "obligationCalendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadence",
        "monthConvention",
        "anchorBinding",
        "amountBinding",
        "calendarAdjustment",
        "paymentAdmission"
      ],
      "properties": {
        "cadence": {
          "const": "monthly"
        },
        "monthConvention": {
          "enum": [
            "clamp",
            "preserve_month_end"
          ]
        },
        "anchorBinding": {
          "const": "private_original_anchor"
        },
        "amountBinding": {
          "const": "private_confirmed_fixed_amount"
        },
        "calendarAdjustment": {
          "const": "none_source_declared"
        },
        "paymentAdmission": {
          "const": "exact_due_date_and_phase_no_cumulative_excess"
        }
      }
    },
    "openingState": {
      "const": "confirm_no_carried_overdue_obligations_or_default"
    },
    "excludedPeriodEffects": {
      "const": "source_reviewed_absence_in_selected_period_of_advances_extra_payments_redraw_offset_reversals_packages_closure"
    },
    "fees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "ordering",
        "occurrences"
      ],
      "properties": {
        "coverage": {
          "const": "complete_source_inventory"
        },
        "ordering": {
          "enum": [
            "before_scenario_events",
            "after_scenario_events"
          ]
        },
        "occurrences": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "incurredDate",
              "dueDate",
              "order",
              "amount",
              "debit",
              "settlement",
              "externalAccountRole",
              "evidenceIds"
            ],
            "properties": {
              "id": {
                "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/key"
              },
              "incurredDate": {
                "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/date"
              },
              "dueDate": {
                "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/date"
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "amount": {
                "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/money"
              },
              "debit": {
                "const": "external_account"
              },
              "settlement": {
                "const": "exact_cleared_due_date_amount_and_account"
              },
              "externalAccountRole": {
                "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/key"
              },
              "evidenceIds": {
                "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/hashes"
              }
            }
          }
        }
      }
    },
    "eligibility": {
      "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/rule"
    },
    "inputDefinitions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "label",
          "type",
          "unit",
          "binding",
          "evidenceIds"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "type": {
            "enum": [
              "boolean",
              "decimal",
              "date",
              "text"
            ]
          },
          "unit": {
            "oneOf": [
              {
                "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/key"
              },
              {
                "type": "null"
              }
            ]
          },
          "binding": {
            "enum": [
              "customer_fact",
              "opening_principal",
              "obligation_amount",
              "from_date",
              "to_exclusive_date",
              "confirmed_annual_rate",
              "offer_purpose",
              "offer_security",
              "repayment_type"
            ]
          },
          "evidenceIds": {
            "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/hashes"
          }
        }
      }
    },
    "fieldEvidenceIds": {
      "$ref": "urn:ar-local:monetary-mortgage-draft:definitions#/$defs/fieldEvidence"
    }
  }
}
