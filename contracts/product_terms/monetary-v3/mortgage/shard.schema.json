{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ar-local:monetary-mortgage-draft:shard",
  "$comment": "DRAFT ONLY. No freeze, bank approval or runtime adoption.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "run_date",
    "core_asset_sha256",
    "details_asset_sha256",
    "products"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "capability": {
      "const": "mortgage_calculation"
    },
    "run_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(19[0-9]{2}|20[0-9]{2}|21[0-9]{2}|2200)-[0-9]{2}-[0-9]{2}$"
    },
    "core_asset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "details_asset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "products": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "$ref": "urn:ar-local:monetary-mortgage-draft:asset"
      }
    }
  }
}
