{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/pi-preservation-snapshot-v1.schema.json",
  "title": "AR-local Pi preservation snapshot v1",
  "type": "object",
  "required": [
    "schema_version", "snapshot_id", "created_at", "started_at", "completed_at", "operator",
    "plan_document_id", "plan_version", "plan_git_commit", "plan_sha256", "plan_raw_sha256",
    "candidate_code_sha", "repositories", "source_paths", "secret_locations", "data_scope", "system_configuration", "systemd_enablement",
    "macro_backup", "source_data_bytes", "capacity_plan", "category_summary", "files", "exact_commands", "deviations", "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "operator": {"type": "string", "minLength": 1},
    "plan_document_id": {"const": "ARL-OPS-001"},
    "plan_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]},
    "plan_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repositories": {"type": "object"},
    "source_paths": {"type": "object"},
    "secret_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "exists", "metadata_status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "exists": {"type": ["boolean", "null"]},
          "metadata_status": {"enum": ["AVAILABLE", "ABSENT", "INACCESSIBLE", "UNAVAILABLE"]},
          "uid": {"type": "integer", "minimum": 0},
          "gid": {"type": "integer", "minimum": 0},
          "mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"}
        },
        "allOf": [
          {"if": {"properties": {"metadata_status": {"const": "AVAILABLE"}}}, "then": {"properties": {"exists": {"const": true}}, "required": ["uid", "gid", "mode"]}},
          {"if": {"properties": {"metadata_status": {"const": "ABSENT"}}}, "then": {"properties": {"exists": {"const": false}}}},
          {"if": {"properties": {"metadata_status": {"enum": ["INACCESSIBLE", "UNAVAILABLE"]}}}, "then": {"properties": {"exists": {"const": null}}}}
        ],
        "additionalProperties": false
      }
    },
    "data_scope": {
      "type": "object",
      "required": ["policy_version", "included", "excluded", "unknown_roots_allowed"],
      "properties": {
        "policy_version": {"const": 1},
        "included": {
          "type": "array", "minItems": 2, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["runs", "state", "logs", "predeploy", "runs-archive"]},
          "allOf": [
            {"contains": {"const": "runs"}},
            {"contains": {"const": "state"}}
          ]
        },
        "excluded": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["path", "exists", "contents_copied", "reason"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "exists": {"type": "boolean"},
              "contents_copied": {"const": false},
              "reason": {"type": "string", "minLength": 1},
              "uid": {"type": "integer", "minimum": 0},
              "gid": {"type": "integer", "minimum": 0},
              "mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"}
            },
            "additionalProperties": false
          },
          "allOf": [
            {"contains": {"type": "object", "properties": {"path": {"const": ".daily-export-stage"}}, "required": ["path"]}},
            {"contains": {"type": "object", "properties": {"path": {"const": "netdata"}}, "required": ["path"]}}
          ]
        },
        "unknown_roots_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "system_configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "snapshot_path", "uid", "gid", "mode", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "snapshot_path": {"type": "string", "minLength": 1},
          "uid": {"type": "integer", "minimum": 0},
          "gid": {"type": "integer", "minimum": 0},
          "mode": {"type": "string", "pattern": "^0o[0-7]{3,4}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "systemd_enablement": {"type": "array"},
    "macro_backup": {"type": "object"},
    "source_data_bytes": {"type": "integer", "minimum": 0},
    "capacity_plan": {
      "type": "object",
      "required": ["snapshot_payload_bytes", "staged_payload_bytes", "per_snapshot_metadata_reserve_bytes", "retained_snapshots", "remaining_slots", "required_free_bytes", "required_after_staging_bytes", "available_free_bytes", "available_after_staging_bytes"],
      "properties": {
        "snapshot_payload_bytes": {"type": "integer", "minimum": 0},
        "staged_payload_bytes": {"type": "integer", "minimum": 0},
        "per_snapshot_metadata_reserve_bytes": {"type": "integer", "minimum": 1},
        "retained_snapshots": {"type": "integer", "minimum": 0},
        "remaining_slots": {"type": "integer", "minimum": 1},
        "required_free_bytes": {"type": "integer", "minimum": 1},
        "required_after_staging_bytes": {"type": "integer", "minimum": 1},
        "available_free_bytes": {"type": "integer", "minimum": 0},
        "available_after_staging_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "category_summary": {"type": "object"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "exact_commands": {"type": "array", "items": {"type": "string"}},
    "deviations": {"type": "array"},
    "result": {"const": "PASS"}
  },
  "additionalProperties": true
}
