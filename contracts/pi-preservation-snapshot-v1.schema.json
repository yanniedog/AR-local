{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://australianrates.app/contracts/pi-preservation-snapshot-v1.schema.json",
  "title": "AR-local Pi preservation snapshot v1",
  "type": "object",
  "required": [
    "schema_version", "snapshot_id", "created_at", "started_at", "completed_at", "operator",
    "plan_document_id", "plan_version", "plan_git_commit", "plan_sha256", "plan_raw_sha256",
    "candidate_code_sha", "repositories", "source_paths", "secret_locations", "systemd_enablement",
    "macro_backup", "source_data_bytes", "category_summary", "files", "exact_commands", "deviations", "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "operator": {"type": "string", "minLength": 1},
    "plan_document_id": {"const": "ARL-OPS-001"},
    "plan_version": {"const": "1.0"},
    "plan_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repositories": {"type": "object"},
    "source_paths": {"type": "object"},
    "secret_locations": {"type": "array"},
    "systemd_enablement": {"type": "array"},
    "macro_backup": {"type": "object"},
    "source_data_bytes": {"type": "integer", "minimum": 0},
    "category_summary": {"type": "object"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "exact_commands": {"type": "array", "items": {"type": "string"}},
    "deviations": {"type": "array"},
    "result": {"const": "PASS"}
  },
  "additionalProperties": true
}
